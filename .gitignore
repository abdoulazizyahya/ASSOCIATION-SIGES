/vendor/

# ── Fichiers générés / mis en cache sur disque (régénérables à la volée,
# voir pdf/verif_lib.php, pdf/header_pdf.php, pdf/fpdf.php) ────────────
/assets/uploads/fond_degrade_*.png
/assets/uploads/filigrane_logo.png
/assets/uploads/filigrane_*.png
/assets/uploads/qr_bulletins/
/assets/uploads/qr_honneur/
/assets/uploads/qr_recus/

# ── Données personnelles élèves (photos, dossiers) — jamais en dépôt,
# même privé : à restaurer depuis un backup séparé si besoin ──────────
/assets/uploads/eleves/
/assets/uploads/dossiers_eleves/
/assets/uploads/profils/

# ── Images propres à chaque école (logos, signatures, bordures) déposées
# via Paramètres — données, pas du code. Racine de uploads/ seulement :
# les logos d'opérateurs (assets/uploads/operateurs/) restent versionnés.
/assets/uploads/*.jpg
/assets/uploads/*.jpeg
/assets/uploads/*.png

# ── Dumps SQL de sauvegarde (contiennent des données réelles d'élèves,
# pas seulement le schéma — les migrations elles-mêmes (migration_v*.sql)
# restent versionnées, ce sont les backup_*.sql à écarter) ────────────
/bd/backup_*.sql
/bd/sauvegardes/

# ── Uploads par école (logos/signatures/pièces de dossier) — voir
# fonctions.php::upload_prefixe_etab(). Le logo par défaut (logo_etab.jpg
# à la racine) reste versionné ; les sous-dossiers par école, non. ─────
/assets/uploads/etab/

# ── Config locale Claude Code (spécifique à ce poste) ──────────────────
/.claude/settings.local.json

# ── Surcharge de config par environnement (identifiants BD prod, APP_URL,
# domaine, jeton de sauvegarde…) — jamais en dépôt. Modèle versionné :
# config.local.php.example ────────────────────────────────────────────
/config.local.php

# Fichiers verrouillage Office (~$...) — jamais versionnés
~$*

# ── Portail d'accueil : accueil.php est la source (versionnée). La copie
# statique promeducamsiges.html est REGÉNÉRÉE (bd/assoc/generer_accueil.php,
# + auto à la création/modif/suppression d'une école) → non versionnée.
/promeducamsiges.html

# ── .htaccess racine : en LAN, une seule ligne (DirectoryIndex accueil.php
# index.php) ; en prod, copie de deploy/htaccess-prod.txt. Spécifique au
# poste → non versionné (le modèle prod reste dans deploy/). ───────────
/.htaccess
